[Unit]
Description=SpeakEasy (plain Node, no dependencies)
After=network.target
# Asks the moderator to score transcript lines, but runs fine without it:
# lines wait, marked unchecked, until it answers. So Wants, not Requires.
Wants=speakeasy-moderator.service

# The checkout is on the 20GB volume at /mnt/twenty_gb_volume/opt/speakeasy, with
# /opt/speakeasy a symlink to it. It moved there when the moderator arrived:
# onnxruntime's node_modules is ~290MB, and root has ~3.4G to spare. The app
# itself still has no dependencies.
RequiresMountsFor=/mnt/twenty_gb_volume

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/speakeasy

# Loopback only, like every other Node process on this box. nginx is the only
# thing that should reach it. Port allocation as of 2026-10-17:
#   3001 daycards   3002 (retired: clef)   3003 gate   3004 champpool
#   3005 uvaguessr  3006 vs   3007 landing (not enabled)   3008 speakeasy
Environment=HOST=127.0.0.1
Environment=PORT=3008

# Rooms live in memory and are snapshotted here every 15s and on SIGTERM, so a
# deploy (`systemctl restart`) does not end a meeting in progress. Outside the
# checkout so a `git pull` can never touch it. StateDirectory creates
# /var/lib/speakeasy owned by www-data.
StateDirectory=speakeasy
Environment=SPEAKEASY_STATE_FILE=/var/lib/speakeasy/rooms.json

# Accounts: who a request belongs to is asked of Grounds Guessr over loopback
# (this app never holds the site's session key), and each account's notes and
# scheduled meetings are one JSON file here. On the volume, because it is
# user data that grows with users -- the site's rule for what goes where.
# The directory must exist and belong to www-data; see README "Deploy".
Environment=SPEAKEASY_ACCOUNTS_ME_URL=http://127.0.0.1:3005/groundsguessr/api/auth/me
Environment=SPEAKEASY_USER_DIR=/mnt/twenty_gb_volume/speakeasy/users
# Archived meetings (history.js): one file per meeting, plus each account's list.
Environment=SPEAKEASY_MEETING_DIR=/mnt/twenty_gb_volume/speakeasy/meetings

# ~45MB resident. The ceiling is a guard on a 458MB box, not a tuning knob:
# the app's own caps (one room, 24 people, 4000 transcript lines) keep it far
# below this.
MemoryMax=128M

ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
